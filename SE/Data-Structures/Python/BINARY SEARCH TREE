from collections import deque
import copy


class Node:
    def __init__(self, data):
        self.data = data
        self.left = None
        self.right = None


def insert(root, data):
    if root is None:
        return Node(data)

    if data < root.data:
        root.left = insert(root.left, data)
    elif data > root.data:
        root.right = insert(root.right, data)
    else:
        print("Duplicate Entry Not Allowed")

    return root


def search(root, key):
    if root is None:
        return False

    if root.data == key:
        return True

    if key < root.data:
        return search(root.left, key)
    else:
        return search(root.right, key)


def findMin(root):
    while root.left is not None:
        root = root.left
    return root


def delete(root, key):
    if root is None:
        return root

    if key < root.data:
        root.left = delete(root.left, key)

    elif key > root.data:
        root.right = delete(root.right, key)

    else:
        if root.left is None:
            return root.right

        if root.right is None:
            return root.left

        temp = findMin(root.right)
        root.data = temp.data
        root.right = delete(root.right, temp.data)

    return root


def inorder(root):
    if root is not None:
        inorder(root.left)
        print(root.data, end=" ")
        inorder(root.right)


def preorder(root):
    if root is not None:
        print(root.data, end=" ")
        preorder(root.left)
        preorder(root.right)


def postorder(root):
    if root is not None:
        postorder(root.left)
        postorder(root.right)
        print(root.data, end=" ")


def depth(root):
    if root is None:
        return 0

    return 1 + max(depth(root.left), depth(root.right))


def mirror(root):
    if root is not None:
        root.left, root.right = root.right, root.left
        mirror(root.left)
        mirror(root.right)


def leaf(root):
    if root is not None:
        if root.left is None and root.right is None:
            print(root.data, end=" ")

        leaf(root.left)
        leaf(root.right)


def parent(root):
    if root is not None:
        print(
            root.data, "->",
            root.left.data if root.left else "-",
            root.right.data if root.right else "-"
        )

        parent(root.left)
        parent(root.right)


def level(root):
    if root is None:
        return

    q = deque()
    q.append(root)

    while q:
        temp = q.popleft()

        print(temp.data, end=" ")

        if temp.left is not None:
            q.append(temp.left)

        if temp.right is not None:
            q.append(temp.right)


# Main Program

root = None

values = [50, 30, 70, 20, 40, 60, 80]

for x in values:
    root = insert(root, x)


print("Inorder:")
inorder(root)

print("\nPreorder:")
preorder(root)

print("\nPostorder:")
postorder(root)

print("\nSearch 40:", search(root, 40))

print("Depth:", depth(root))

print("Leaf Nodes:")
leaf(root)

print("\n\nParent -> Children")
parent(root)

print("\nLevel Order:")
level(root)

# Copy Tree
copyTree = copy.deepcopy(root)
print("\n\nTree Copied Successfully")

# Mirror Tree
mirror(root)

print("Mirror Inorder:")
inorder(root)

# Delete
root = delete(root, 60)

print("\n\nAfter Deleting 60:")
inorder(root)

print()
