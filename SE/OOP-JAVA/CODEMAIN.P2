package oop;

import java.util.Scanner;

class Publication {
    String title;
    double price;
    int copies;

    Publication(String title, double price, int copies) {
        this.title = title;
        this.price = price;
        this.copies = copies;
    }

    double saleCopy() {
        return price * copies;
    }

    void display() {
        System.out.println("Title: " + title);
        System.out.println("Price: " + price);
        System.out.println("Copies Sold: " + copies);
    }
}

class Book extends Publication {
    String author;

    Book(String title, double price, int copies, String author) {
        super(title, price, copies);
        this.author = author;
    }

    @Override
    void display() {
        super.display();
        System.out.println("Author: " + author);
        System.out.println("Total Sale: " + saleCopy());
    }
}

class Magazine extends Publication {
    int issueNumber;

    Magazine(String title, double price, int copies, int issueNumber) {
        super(title, price, copies);
        this.issueNumber = issueNumber;
    }

    @Override
    void display() {
        super.display();
        System.out.println("Issue Number: " + issueNumber);
        System.out.println("Total Sale: " + saleCopy());
    }
}

public class codemain {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.println("===== PUBLICATION MANAGEMENT SYSTEM =====");

        System.out.print("Enter Book Title: ");
        String bookTitle = sc.nextLine();

        System.out.print("Enter Book Price: ");
        double bookPrice = sc.nextDouble();

        System.out.print("Enter Book Copies Sold: ");
        int bookCopies = sc.nextInt();

        sc.nextLine();

        System.out.print("Enter Author Name: ");
        String author = sc.nextLine();

        Book book = new Book(bookTitle, bookPrice, bookCopies, author);

        System.out.println("\n----- BOOK DETAILS -----");
        book.display();

        System.out.println();

        System.out.print("Enter Magazine Title: ");
        String magazineTitle = sc.nextLine();

        System.out.print("Enter Magazine Price: ");
        double magazinePrice = sc.nextDouble();

        System.out.print("Enter Magazine Copies Sold: ");
        int magazineCopies = sc.nextInt();

        System.out.print("Enter Issue Number: ");
        int issueNumber = sc.nextInt();

        Magazine magazine = new Magazine(
                magazineTitle,
                magazinePrice,
                magazineCopies,
                issueNumber
        );

        System.out.println("\n----- MAGAZINE DETAILS -----");
        magazine.display();

        sc.close();
    }
}

